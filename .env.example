# ============================================================
# Elvira Technologies — environment configuration
#
# 1. Copy this file to ".env.local" for local testing with
#    `vercel dev`, and/or paste each of these into
#    Vercel → your project → Settings → Environment Variables.
# 2. NEVER put real keys in this file: it is committed to GitHub.
#    Real values only go in ".env.local" (ignored by git) and Vercel.
# ============================================================

# --- Discord OAuth (Discord Developer Portal → your app → OAuth2) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://YOUR-DOMAIN.vercel.app/api/auth/discord/callback

# --- Roblox OAuth (legacy, optional — the 6-digit code flow doesn't need it) ---
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=
ROBLOX_REDIRECT_URI=https://YOUR-DOMAIN.vercel.app/api/roblox/verify/callback

# --- Supabase (Project Settings → API / Data API) ---
# Project URL only, e.g. https://abcdefgh.supabase.co  (no /rest/v1/ at the end)
SUPABASE_URL=
# The SECRET key (sb_secret_...). Server only — never expose it.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: the PUBLISHABLE key (sb_publishable_...). Lets the browser upload
# product images/files straight to Supabase Storage. Safe to be public.
SUPABASE_PUBLISHABLE_KEY=

# --- Roblox game shared secret (Studio Script -> /api/roblox/*) ---
# Must match the SHARED_SECRET value pasted in the Roblox game's server script.
ROBLOX_GAME_SECRET=

# --- Session signing ---
# Any long random string, e.g. generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# --- Public URL of this website (no trailing slash) ---
SITE_URL=https://YOUR-DOMAIN.vercel.app

# ============================================================
# SHOPPEX.IO  (payments)  <<< fill these in
# ============================================================
# Shoppex dashboard -> Settings -> Developer -> API keys. Secret key (shx_...). Server only.
SHOPPEX_API_KEY=
# Currency of your Shoppex shop / prices (EUR by default)
SHOPPEX_CURRENCY=EUR
# Optional: force one gateway (e.g. STRIPE, PAYPAL). Leave empty so the buyer chooses.
SHOPPEX_GATEWAY=
# Only change if Shoppex tells you to.
SHOPPEX_API_URL=https://api.shoppex.io
